# ClariFlow Backend Environment Variables
# Copy this file to .env and fill in your values

# Environment
ENVIRONMENT=development
DEBUG=true

# Database Configuration
DATABASE_URL=sqlite:///clariflow.db

# Security Configuration (REQUIRED for production)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Configuration
COOKIE_SECURE=false  # Set to true in production with HTTPS
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# AI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_DEFAULT_MODEL=deepseek/deepseek-chat-v3-0324

# --- AI Model Assignments (OpenRouter free models) ---
# These are used for feature-specific routing in ClariFlow. You can override as needed.
# See backend/app/services/ai_client.py and backend/app/utils/model_router.py for details.

# Chat (conversational AI)
AI_MODEL_CHAT=deepseek/deepseek-chat-v3-0324:free
# Search (semantic search/Q&A)
AI_MODEL_SEARCH=deepseek/deepseek-v3-base:free
# Insights (data analysis, summarization)
AI_MODEL_INSIGHTS=deepseek/deepseek-r1:free
# Summarization (document/paragraph summaries)
AI_MODEL_SUMMARIZATION=deepseek/deepseek-r1:free
# Composition (email, proposal, content creation)
AI_MODEL_COMPOSITION=qwen/qwen2.5-vl-72b-instruct:free
# Task Extraction (action item parsing)
AI_MODEL_TASK_EXTRACTION=deepseek/deepseek-chat-v3-0324:free

# Fallback models (used if primary fails)
AI_MODEL_FALLBACK=deepseek/deepseek-chat-v3-0324:free

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_EXTENSIONS=[".pdf",".docx",".txt",".csv",".xlsx",".xls",".md"]

# ChromaDB Configuration
CHROMA_PERSIST_DIRECTORY=chroma_db

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]
CORS_ALLOW_CREDENTIALS=true

# Google OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Configuration (Optional - for email verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
EMAIL_FROM=your-email@gmail.com

# API Keys (Optional - for internal tools)
API_KEYS=["test_key_1","test_key_2","test_key_3"]

# Logging
LOG_LEVEL=INFO 

# --- Frontend URL for email links ---
# Used for email verification and password reset links. Set to your deployed frontend URL in production.
FRONTEND_BASE_URL=http://localhost:3000 

# --- Chat/AI Tuning ---
# Minimum relevance score for document context (0.0-1.0, default: 0.3)
SIMILARITY_THRESHOLD=0.3
# Max chat history turns to keep (default: 5)
MAX_HISTORY_LENGTH=5 

# --- API Settings ---
# API version prefix (default: /api/v1)
API_V1_STR=/api/v1
# Project name (default: ClariFlow)
PROJECT_NAME=ClariFlow 